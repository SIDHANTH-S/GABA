{
  "name": "ai-browser-integrated",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"wait-on http://localhost:8443 && npm run dev:electron\"",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:electron": "npm run build:electron && electron apps/browser-shell",
    "build": "npm run build:frontend && npm run build:electron",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:electron": "tsc -p tsconfig.main.json",
    "seed": "npx tsx scripts/seed-memory.ts",
    "test:parser": "electron -r tsx/register scripts/test-parser.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.4.2",
    "openai": "^4.104.0",
    "papaparse": "^5.4.1",
    "uuid": "^14.0.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/papaparse": "^5.3.14",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "electron": "^30.5.1",
    "tsx": "^4.23.11",
    "typescript": "^5.2.0",
    "wait-on": "^7.2.0"
  }
}
