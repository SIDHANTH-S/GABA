{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/main",
    "module": "CommonJS",
    "target": "ES2020",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node"
  },
  "include": [
    "electron-main/**/*",
    "agent-core/**/*",
    "semantic-parser/**/*",
    "shared/**/*",
    "scripts/**/*"
  ]
}
